@model List<Order>
@{
    ViewData["Title"] = "Home Page";
}

<h1 class="display-4">Order List</h1>
<table class="table">
    <thead>
    <tr>
        <th>Customer Name</th>
        <th>Order Date</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var order in Model)
    {
        <tr>
            <td>@order.CustomerName</td>
            <td>@order.OrderDate.ToShortDateString()</td>
            <td>
                <a asp-action="Edit" asp-route-id="@order.OrderId" class="btn btn-primary">Edit</a>
                <a asp-action="Delete" asp-route-id="@order.OrderId" class="btn btn-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>

