@model Order
@{
    ViewData["Title"] = "Create Order";
}

<h1 class="display-4">Create Order</h1>
<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div class="col-4">
        <div class="mb-3">
            <label asp-for="CustomerName"></label>
            <input asp-for="CustomerName" class="form-control" />
            <span asp-validation-for="CustomerName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="OrderDate"></label>
            <input asp-for="OrderDate" class="form-control" type="date" />
            <span asp-validation-for="OrderDate" class="text-danger"></span>
        </div>
    </div>
    
    <table class="table">
        <thead>
            <tr>
                <th>Product Name</th>
                <th>Quantity</th>
                <th>Price</th>
            </tr>
        </thead>
        <tbody>
            @if (Model?.OrderDetails != null && Model.OrderDetails.Count > 0)
            {
                @for (int i = 0; i < Model.OrderDetails.Count; i++)
                {
                    <tr>
                        <td>
                            <input asp-for="OrderDetails[@i].ProductName" class="form-control" />
                            <span asp-validation-for="OrderDetails[@i].ProductName" class="text-danger"></span>
                        </td>
                        <td>
                            <input asp-for="OrderDetails[@i].Quantity" class="form-control" />
                            <span asp-validation-for="OrderDetails[@i].Quantity" class="text-danger"></span>
                        </td>
                        <td>
                            <input asp-for="OrderDetails[@i].Price" class="form-control" />
                            <span asp-validation-for="OrderDetails[@i].Price" class="text-danger"></span>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
    <button type="submit" class="btn btn-primary">Create</button>
</form>