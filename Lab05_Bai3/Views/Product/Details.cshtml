@model Lab05_Bai3.Models.Product

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    .details-card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.05);
        background: #ffffff;
    }
    .details-header {
        background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
        color: white;
        border-radius: 15px 15px 0 0 !important;
        padding: 24px;
    }
    .badge-active {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: white;
        font-size: 0.85rem;
        padding: 6px 12px;
        border-radius: 20px;
    }
    .badge-inactive {
        background: linear-gradient(135deg, #f43f5e 0%, #e11d48 100%);
        color: white;
        font-size: 0.85rem;
        padding: 6px 12px;
        border-radius: 20px;
    }
    .btn-action {
        border-radius: 8px;
        padding: 8px 16px;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s ease;
    }
</style>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card details-card">
                <div class="card-header details-header border-0 d-flex justify-content-between align-items-center">
                    <div>
                        <h3 class="mb-0 fw-bold"><i class="bi bi-info-circle-fill me-2"></i>Chi tiết sản phẩm</h3>
                        <p class="mb-0 text-white-50 mt-1">Thông tin chi tiết được lưu trong hệ thống</p>
                    </div>
                    <span class="fs-4 text-white-50">#@Model.Id</span>
                </div>
                <div class="card-body p-4">
                    <div class="row mb-4">
                        <div class="col-sm-4 text-muted fw-semibold">Tên sản phẩm</div>
                        <div class="col-sm-8 text-dark fw-bold fs-5">@Model.Name</div>
                    </div>
                    
                    <hr class="text-muted opacity-25" />

                    <div class="row mb-4">
                        <div class="col-sm-4 text-muted fw-semibold">Giá niêm yết</div>
                        <div class="col-sm-8 text-primary fw-bold fs-5">
                            @(Model.Price.HasValue ? Model.Price.Value.ToString("C0", new System.Globalization.CultureInfo("vi-VN")) : "Liên hệ")
                        </div>
                    </div>

                    <hr class="text-muted opacity-25" />

                    <div class="row mb-4">
                        <div class="col-sm-4 text-muted fw-semibold">Số lượng trong kho</div>
                        <div class="col-sm-8 text-dark fw-semibold fs-5">@Model.Quantity sản phẩm</div>
                    </div>

                    <hr class="text-muted opacity-25" />

                    <div class="row mb-4">
                        <div class="col-sm-4 text-muted fw-semibold">Trạng thái kinh doanh</div>
                        <div class="col-sm-8">
                            @if (Model.Status == true)
                            {
                                <span class="badge badge-active"><i class="bi bi-check-circle me-1"></i>Đang kinh doanh</span>
                            }
                            else
                            {
                                <span class="badge badge-inactive"><i class="bi bi-x-circle me-1"></i>Ngừng kinh doanh</span>
                            }
                        </div>
                    </div>

                    <hr class="my-4 text-muted opacity-25" />

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-action">
                            <i class="bi bi-arrow-left"></i> Quay lại danh sách
                        </a>
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-action">
                            <i class="bi bi-pencil-square"></i> Sửa sản phẩm
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
