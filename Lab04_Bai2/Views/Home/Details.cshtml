@model Product

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Chi tiết sản phẩm</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="container mt-5">

    <div class="row">

        <!-- ===== ẢNH SẢN PHẨM ===== -->
        <div class="col-md-6 text-center">
            <img src="@Model.ImageUrl" class="img-fluid" style="max-height:400px;" />
        </div>

        <!-- ===== THÔNG TIN ===== -->
        <div class="col-md-6">

            <h2>@Model.ProductName</h2>

            <h4 class="text-danger">$@Model.Price</h4>

            <p><b>Danh mục:</b> @Model.Category?.CategoryName</p>

            <p><b>Số lượng:</b> @Model.Quantity</p>

            <p class="mt-3">@Model.Description</p>

            <!-- ===== NÚT ===== -->
            <div class="mt-4">
                <button class="btn btn-primary">Add to Cart</button>
                <button class="btn btn-success">Buy Now</button>
            </div>

            <div class="mt-3">
                <a href="/Home/Index" class="btn btn-secondary">← Quay lại</a>
            </div>

        </div>

    </div>

</body>
</html>