@model List<Product>
@{
    var categories = ViewBag.Categories as List<Category>;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Shop</title>

    <!-- Bootstrap cho đẹp -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="container mt-4">

    <!-- ===== SHOP FOR (CATEGORIES) ===== -->
    <h3 class="mb-3">SHOP FOR</h3>

    <div class="row mb-5">
        @foreach (var c in categories)
        {
            <div class="col-md-2 text-center">
                <img src="@c.ImageUrl" class="img-fluid" style="height:100px; object-fit:cover;" />
                <p class="mt-2">@c.CategoryName</p>
            </div>
        }
    </div>

    <!-- ===== FEATURED PRODUCTS ===== -->
    <h3 class="mb-3">FEATURED COLLECTION</h3>

    <div class="row">
        @foreach (var p in Model)
        {
            <div class="col-md-3 mb-4">
                <div class="card h-100 shadow-sm">

                    <img src="@p.ImageUrl" class="card-img-top" style="height:200px; object-fit:cover;" />

                    <div class="card-body text-center">
                        <h6>@p.ProductName</h6>
                        <p class="text-danger fw-bold">$@p.Price</p>

                        <a href="/Home/Details/@p.ProductId" class="btn btn-primary btn-sm">
                            Chi tiết
                        </a>
                    </div>

                </div>
            </div>
        }
    </div>

</body>
</html>